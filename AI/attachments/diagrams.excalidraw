      "isDeleted": false,
      "boundElements": [],
      "updated": 1767992566703,
      "link": null,
      "locked": false,
      "text": "Allow them to add\nan intersection to\nour system in a\nnon-invasive way\nwhich can work\nside-by-side with\ntheir existing\nATMS. E.g. allow\nthem to configure it\nso we don't poll the\ncontroller but only\nuse our system for\nthe incident\nmanagement.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "51FPAKHugy2fsCycGeat_",
      "originalText": "Allow them to add an intersection to our system in a non-invasive way which can work side-by-side with their existing ATMS. E.g. allow them to configure it so we don't poll the controller but only use our system for the incident management.",
      "autoResize": true,
      "lineHeight": 1.25
    },
